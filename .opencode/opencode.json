{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    ".opencode/plugins/graphify.js",
    "superpowers@git+https://github.com/obra/superpowers.git"
  ],
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp"
    },
    "gh_grep": {
      "type": "remote",
      "url": "https://mcp.grep.app"
    },
    "memory": {
      "type": "local",
      "command": ["bun", "x", "@modelcontextprotocol/server-memory"],
      "enabled": true,
      "environment": {
        "MEMORY_FILE_PATH": "/home/tu4nng/.local/share/opencode/memory.jsonl"
      },
      "timeout": 10000
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "@playwright/mcp@latest"],
      "enabled": true,
      "timeout": 30000
    },
    "sequential-thinking": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-sequential-thinking"],
      "enabled": true,
      "timeout": 10000
    }
  },
  "agent": {
    "architect": {
      "mode": "subagent",
      "model": "opencode/glm-5.1",
      "options": {
        "temperature": 0.7
      }
    },
    "manager": {
      "mode": "subagent",
      "model": "opencode/qwen3.6-plus",
      "options": {
        "temperature": 0.2
      }
    },
    "coder": {
      "mode": "subagent",
      "model": "opencode/deepseek-v4-flash-free",
      "options": {
        "temperature": 0.1
      }
    },
    "tester": {
      "mode": "subagent",
      "model": "opencode/deepseek-v4-flash-free",
      "options": {
        "temperature": 0.1
      }
    },
    "general": {
      "model": "opencode/glm-5.1",
      "options": {
        "temperature": 0.3
      }
    }
  }
}