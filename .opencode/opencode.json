{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    ".opencode/plugins/graphify.js",
    "superpowers@git+https://github.com/obra/superpowers.git"
  ],
  "command": {
    "todo": {
      "description": "Generate a project briefing — what's done, what's overdue, what to work on next",
      "prompt": "Invoke the todo skill to generate a project briefing. Read STATE.md, the refactor plan, git log, and previous briefing. Show what's overdue, what's done, what's next, and a 30-minute plan for today."
    }
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp"
    },
    "gh_grep": {
      "type": "remote",
      "url": "https://mcp.grep.app"
    },
    "memory": {
      "type": "local",
      "command": ["bun", "x", "@modelcontextprotocol/server-memory"],
      "enabled": true,
      "environment": {
        "MEMORY_FILE_PATH": "/home/tu4nng/.local/share/opencode/memory.jsonl"
      },
      "timeout": 10000
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "@playwright/mcp@latest"],
      "enabled": true,
      "timeout": 30000
    },
    "sequential-thinking": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-sequential-thinking"],
      "enabled": true,
      "timeout": 10000
    }
  }
}